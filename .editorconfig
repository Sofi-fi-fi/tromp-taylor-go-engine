root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{json,xml,props,targets,csproj,slnx,yml,yaml}]
indent_style = space
indent_size = 2

[*.cs]
indent_style = space
indent_size = 4

# Namespaces
csharp_style_namespace_declarations = file_scoped
dotnet_diagnostic.IDE0161.severity = warning

# Unused usings (works in build because GenerateDocumentationFile = true)
dotnet_diagnostic.IDE0005.severity = warning

# Fields that are never reassigned must be readonly
dotnet_style_readonly_field = true
dotnet_diagnostic.IDE0044.severity = warning

# Unused private members / parameters: dead code hides logic bugs
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0060.severity = warning

# Always braces: avoids "if (x) a(); b();" mistakes in rule logic
csharp_prefer_braces = true
dotnet_diagnostic.IDE0011.severity = warning

# Explicit accessibility: makes public/internal choice visible
dotnet_style_require_accessibility_modifiers = for_non_interface_members
dotnet_diagnostic.IDE0040.severity = warning
